# --- Supply-chain hardening (auto-update protection) ---
# 既定で pnpm-lock.yaml に固定されたバージョンのみをインストールする。
# package.json の ^ 範囲があっても、ロックファイルと一致しなければ install を失敗させ、
# 意図しないマイナー/パッチの自動アップデート混入を防ぐ。
# 依存を意図的に更新する場合のみ `pnpm install --no-frozen-lockfile` を使う。
frozen-lockfile=true

# 新しい依存を追加する際、バージョン範囲(^/~)を付けず正確なバージョンで保存する。
save-exact=true
